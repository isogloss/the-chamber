<Window x:Class="TheChamber.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Chamber"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Width="960" Height="640"
        Background="{StaticResource ChamberBg}"
        FontFamily="{StaticResource ChamberMono}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- Centered chamber image. Dithered look is baked in via the
             image filter; render at exact pixel size to keep it crisp. -->
        <Image Grid.Row="0"
               Source="pack://application:,,,/Resources/chamber.png"
               Stretch="Uniform"
               Margin="0,48,0,24"
               Opacity="0.92"
               SnapsToDevicePixels="True"
               UseLayoutRounding="True"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <TextBlock Grid.Row="1"
                   Text="THE CHAMBER"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource ChamberFg}"
                   FontSize="{StaticResource ChamberFontSizeHero}"
                   FontWeight="Light"
                   FontFamily="{StaticResource ChamberMono}" />

        <TextBlock Grid.Row="2"
                   Text="defensive hypervisor"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource ChamberFgDim}"
                   FontSize="{StaticResource ChamberFontSizeSmall}"
                   Margin="0,6,0,0" />

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text=""
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource ChamberFgFaint}"
                   FontSize="{StaticResource ChamberFontSizeSmall}"
                   Margin="0,36,0,0" />

        <!-- Footer rule -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource ChamberLine}">
            <TextBlock Text="passive-dump sandbox / AMD-SVM"
                       Foreground="{StaticResource ChamberFgFaint}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,16,0" />
        </Border>
    </Grid>
</Window>
