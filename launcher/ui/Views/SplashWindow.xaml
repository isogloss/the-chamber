<Window x:Class="TheChamber.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Chamber"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Width="1400" Height="900"
        Background="#FF000000"
        FontFamily="{StaticResource ChamberMono}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Bare-minimum splash: a hooded-figure ASCII art reveal above a
         "THE CHAMBER" word-mark on pure black. Everything else that used to
         live here (chamber.png hero, subtitle, status line, footer rule) has
         been stripped. The StatusText block is kept as a non-rendered sink so
         the public SetStatus API on the code-behind still has somewhere to
         write; it is never shown. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Art container. Scaled uniformly to fit the window; the per-line
             TextBlocks are built on Loaded by SplashWindow.xaml.cs and
             animated in top-to-bottom. -->
        <Viewbox Grid.Row="0"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="24,24,24,8">
            <StackPanel x:Name="ArtHost" />
        </Viewbox>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,40">
            <TextBlock x:Name="TitleText"
                       Text="THE CHAMBER"
                       Foreground="#FFE8F4F8"
                       FontFamily="{StaticResource ChamberMono}"
                       FontSize="{StaticResource ChamberFontSizeHero}"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       Opacity="0" />

            <!-- SetStatus() targets this hidden sink so callers in App.xaml.cs
                 still compile. Collapsed, so it takes no layout space and
                 renders nothing. -->
            <TextBlock x:Name="StatusText"
                       Text=""
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
