<Window x:Class="TheChamber.Views.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TheChamber.Views"
        Title="The Chamber: operator"
        Width="880" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChamberBg}"
        FontFamily="{StaticResource ChamberMono}"
        Foreground="{StaticResource ChamberFg}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="OPERATOR"
                           Foreground="{StaticResource ChamberFg}"
                           FontSize="22" />
                <TextBlock Text="chamber live"
                           Style="{StaticResource ChamberLabel}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Ellipse x:Name="LivenessDot"
                         Width="10" Height="10"
                         Fill="{StaticResource ChamberFgDim}"
                         Margin="0,6,8,0" />
                <TextBlock x:Name="LivenessText"
                           Text="idle"
                           Style="{StaticResource ChamberValue}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ChamberFgDim}" />
            </StackPanel>
        </Grid>

        <!-- Wave 6: two tabs — the original flat status surface moves
             under STATUS, and DUMP hosts the new operator-facing dump
             controls. Nothing on the STATUS tab moved; the StatusPanel
             still lives inside the same bordered panel as before so
             PollStatus's RenderRow calls do not need to change. -->
        <TabControl Grid.Row="1" Margin="0,20,0,0">
            <TabItem Header="STATUS">
                <Border Margin="0,12,0,0"
                        Background="{StaticResource ChamberPanel}"
                        BorderBrush="{StaticResource ChamberLine}"
                        BorderThickness="1"
                        Padding="20">
                    <StackPanel x:Name="StatusPanel" />
                </Border>
            </TabItem>

            <TabItem Header="DUMP">
                <v:DumpTab x:Name="DumpTabContent" />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterText"
                       Grid.Column="0"
                       Style="{StaticResource ChamberLabel}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="shutdown"
                    Click="OnShutdown"
                    Padding="28,8" />
        </Grid>
    </Grid>
</Window>
