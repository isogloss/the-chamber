<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Palette: brutalist, high-contrast, near-mono. The one accent is a
         cold green used only for the live "ok" indicator in the operator
         pane. Nothing in the UI uses more than two shades of gray away
         from pure black. -->
    <Color x:Key="ChamberBgColor">#FF0A0A0A</Color>
    <Color x:Key="ChamberBgAltColor">#FF141414</Color>
    <Color x:Key="ChamberPanelColor">#FF1A1A1A</Color>
    <Color x:Key="ChamberLineColor">#FF2A2A2A</Color>
    <Color x:Key="ChamberFgColor">#FFE6E6E6</Color>
    <Color x:Key="ChamberFgDimColor">#FF808080</Color>
    <Color x:Key="ChamberFgFaintColor">#FF4A4A4A</Color>
    <Color x:Key="ChamberAccentColor">#FF9DFFC6</Color>
    <Color x:Key="ChamberWarnColor">#FFFFB380</Color>

    <SolidColorBrush x:Key="ChamberBg" Color="{StaticResource ChamberBgColor}" />
    <SolidColorBrush x:Key="ChamberBgAlt" Color="{StaticResource ChamberBgAltColor}" />
    <SolidColorBrush x:Key="ChamberPanel" Color="{StaticResource ChamberPanelColor}" />
    <SolidColorBrush x:Key="ChamberLine" Color="{StaticResource ChamberLineColor}" />
    <SolidColorBrush x:Key="ChamberFg" Color="{StaticResource ChamberFgColor}" />
    <SolidColorBrush x:Key="ChamberFgDim" Color="{StaticResource ChamberFgDimColor}" />
    <SolidColorBrush x:Key="ChamberFgFaint" Color="{StaticResource ChamberFgFaintColor}" />
    <SolidColorBrush x:Key="ChamberAccent" Color="{StaticResource ChamberAccentColor}" />
    <SolidColorBrush x:Key="ChamberWarn" Color="{StaticResource ChamberWarnColor}" />

    <!-- Fonts. "Cascadia Mono" is shipped with Win10 20H2+ and Win11; a
         Consolas fallback is explicit so missing fonts don't break layout. -->
    <FontFamily x:Key="ChamberMono">Cascadia Mono,Consolas,Courier New</FontFamily>
    <FontFamily x:Key="ChamberSans">Segoe UI Variable Display,Segoe UI,Arial</FontFamily>

    <sys:Double x:Key="ChamberFontSizeSmall">11</sys:Double>
    <sys:Double x:Key="ChamberFontSize">13</sys:Double>
    <sys:Double x:Key="ChamberFontSizeTitle">22</sys:Double>
    <sys:Double x:Key="ChamberFontSizeHero">42</sys:Double>

    <!-- Base button: flat 1 px line border, no rounded corners. -->
    <Style TargetType="{x:Type Button}" x:Key="ChamberButton">
        <Setter Property="Background" Value="{StaticResource ChamberBgAlt}" />
        <Setter Property="Foreground" Value="{StaticResource ChamberFg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChamberLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontFamily" Value="{StaticResource ChamberMono}" />
        <Setter Property="FontSize" Value="{StaticResource ChamberFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChamberPanel}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChamberFgDim}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChamberBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChamberFg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ChamberButton}" />

    <Style TargetType="{x:Type TextBlock}" x:Key="ChamberText">
        <Setter Property="Foreground" Value="{StaticResource ChamberFg}" />
        <Setter Property="FontFamily" Value="{StaticResource ChamberMono}" />
        <Setter Property="FontSize" Value="{StaticResource ChamberFontSize}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ChamberText}" />

    <Style x:Key="ChamberLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ChamberText}">
        <Setter Property="Foreground" Value="{StaticResource ChamberFgDim}" />
        <Setter Property="FontSize" Value="{StaticResource ChamberFontSizeSmall}" />
    </Style>

    <Style x:Key="ChamberValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ChamberText}">
        <Setter Property="Foreground" Value="{StaticResource ChamberFg}" />
        <Setter Property="FontSize" Value="{StaticResource ChamberFontSize}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ChamberGroupHeader" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ChamberText}">
        <Setter Property="Foreground" Value="{StaticResource ChamberFg}" />
        <Setter Property="FontSize" Value="{StaticResource ChamberFontSizeTitle}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="{x:Type CheckBox}" x:Key="ChamberCheckBox">
        <Setter Property="Foreground" Value="{StaticResource ChamberFg}" />
        <Setter Property="FontFamily" Value="{StaticResource ChamberMono}" />
        <Setter Property="FontSize" Value="{StaticResource ChamberFontSize}" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource ChamberCheckBox}" />

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{StaticResource ChamberBg}" />
        <Setter Property="Foreground" Value="{StaticResource ChamberLine}" />
        <Setter Property="Width" Value="8" />
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="{StaticResource ChamberBg}" />
        <Setter Property="Foreground" Value="{StaticResource ChamberFgDim}" />
        <Setter Property="FontFamily" Value="{StaticResource ChamberMono}" />
        <Setter Property="FontSize" Value="{StaticResource ChamberFontSize}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChamberLine}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChamberFg}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2" />
                            <Setter Property="Foreground" Value="{StaticResource ChamberFg}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ChamberFg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource ChamberBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{StaticResource ChamberBgAlt}" />
        <Setter Property="Foreground" Value="{StaticResource ChamberFg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChamberLine}" />
        <Setter Property="FontFamily" Value="{StaticResource ChamberMono}" />
        <Setter Property="FontSize" Value="{StaticResource ChamberFontSize}" />
    </Style>

    <!-- A thin horizontal rule used between field rows. -->
    <Style TargetType="{x:Type Border}" x:Key="ChamberRule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource ChamberLine}" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

</ResourceDictionary>
