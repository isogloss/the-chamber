# Build artifacts
build/obj/
build/*.obj
*.obj
*.o

# Compiled driver binaries
*.sys
*.pdb
driver/the_chamber.sys
driver/the_chamber.pdb
driver/winhvmon.sys
driver/winhvmon.pdb

# WDK intermediate
*.cat
*.inf.bak

# Logs
logs/*.log
logs/*.err
*.log
*.err

# Signing material — NEVER COMMIT
recovery/*.pfx
recovery/*.key
recovery/*.pvk
recovery/*.p12
*.pfx
*.key
*.pvk
*.p12

# Test certs (public portion only — decide per-file, default exclude)
recovery/*.cer

# OS / editor noise
Thumbs.db
.DS_Store
*.swp
*~
.vs/
.vscode/
*.user

# BCD snapshots (machine-specific)
recovery/*.bcd

# Claude Code subagent worktrees (ephemeral)
.claude/

# Phase 8 CI artifacts
pentest/ci/diff.json
# Phase 8 timestamped run output (baseline.json is committed; per-run output is not)
pentest/results/**/*
!pentest/results/.gitignore

# Phase 8 corpus binaries (never commit samples, only MANIFEST + logs)
pentest/corpus/themida/*
!pentest/corpus/themida/.gitkeep
pentest/corpus/vmprotect/*
!pentest/corpus/vmprotect/.gitkeep
pentest/corpus/enigma/*
!pentest/corpus/enigma/.gitkeep
pentest/corpus/custom/*
!pentest/corpus/custom/.gitkeep

# Probe compile outputs
pentest/probes/**/*.exe
pentest/probes/**/*.obj
pentest/probes/**/*.pdb
